# Root .env.example for docker-compose
# Copy to .env and fill in values

# Database
POSTGRES_DB=teampulse
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=teampulse_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
SECRET_KEY=your-32-char-random-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://ai-service:8000
ENVIRONMENT=development

# Frontend
FRONTEND_PORT=3000
NEXTAUTH_SECRET=your-32-char-random-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# AI Service
AI_SERVICE_PORT=8001
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile